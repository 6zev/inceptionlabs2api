# Listen address. belmo/Docker should use :3000 (the exposed port).
#IL2API_ADDR=:3000

# Static API key for /v1/* routes. Empty/unset = auth disabled (open access).
# Generate one: openssl rand -hex 24
#IL2API_API_KEY=

# Upstream origin. Leave unset for the public Mercury endpoint.
#IL2API_UPSTREAM_BASE=https://chat.inceptionlabs.ai

# Model id advertised and accepted. IL2API_MODELS is a comma-separated
# ACCEPT-LIST of names, not a catalogue: the upstream ignores the model field
# and always serves the same Mercury model, so adding names here only makes the
# gateway accept more labels for one backend. unset = [IL2API_MODEL].
#IL2API_MODEL=mercury-3
#IL2API_MODELS=mercury-3
#
# A "<name>-thinking" alias is added automatically, e.g. mercury-3-thinking.
# It is the SAME backend — it exists only so clients that decide whether to
# offer a thinking-level selector from the model id alone will expose one.
# Cherry Studio is the measured case (its REASONING_REGEX matches ids
# containing reasoning/reasoner/thinking/think): pick mercury-3-thinking there
# and the effort selector appears, which makes the client send
# reasoning_effort and receive reasoning_content. A name that already contains
# one of those words gets no alias.

# Outbound HTTP CONNECT proxy (http://host:port, host:port, https://...).
# When unset, HTTPS_PROXY / HTTP_PROXY / ALL_PROXY are honoured.
# Clearance is acquired from this same egress (the cookie is IP-bound), so a
# proxy must carry both acquisition and ordinary traffic.
#IL2API_PROXY=http://127.0.0.1:18080

# Anonymous session pool.
#IL2API_POOL_MIN=2
#IL2API_POOL_MAX=8
#IL2API_POOL_TTL=30m

# Sliding stream idle watchdog (reset on every upstream line).
#IL2API_IDLE_TIMEOUT=60s

# Deprecated no-op, kept for config compatibility. There is no input guard:
# the upstream truncates at its own context limit (pass-through policy).
#IL2API_CONTEXT_CHARS=0

# Vercel checkpoint clearance (_vcrcs). The gateway holds a small ring of
# cookies (probed: they are fungible, no per-cookie penalty) and rotates one
# per request. Each cookie lives 60 minutes and is proactively replaced at the
# refresh age, one slot per check. A 429 retires only the slot it was carried
# by. Cooldown spaces *failed* solves so a burst of challenges cannot become a
# solve storm; a successful solve never blocks the replay. POOL=1 restores the
# old single-cookie behaviour.
#IL2API_CLEARANCE_REFRESH=45m
#IL2API_CLEARANCE_COOLDOWN=15s
#IL2API_CLEARANCE_POOL=20

# One /api/session fetch timeout.
#IL2API_SESSION_TIMEOUT=15s

# /v1/web_search sliding idle watchdog (reset on every NDJSON line).
#IL2API_SEARCH_TIMEOUT=60s

# Probe /api/search-lab/config once at boot so /healthz can report
# search.available. on/off; a failed probe never disables the endpoint.
#IL2API_SEARCH_CONFIG_CHECK=on
#IL2API_SEARCH_PROBE_TIMEOUT=15s

# Native web search for tool-bearing chat requests. When on, a request that
# carries tools but does not itself declare web_search gets a gateway-served
# web_search tool: the model's calls run against the same retrieval backend as
# /v1/web_search, up to 3 per request, and the client only sees the final
# answer. A client-declared web_search always wins (no interception).
#IL2API_NATIVE_WEB_SEARCH=off

# Audio. One /api/tts or /api/stt call's whole-call timeout, and the
# /v1/audio/transcriptions upload cap (25 MiB matches OpenAI). Transcoding is
# deliberately not implemented: the upstream only decodes MP3 (SPEC §2.5.2).
#IL2API_AUDIO_TIMEOUT=120s
#IL2API_AUDIO_MAX_BYTES=26214400

# Mercury Decide (/v1/decisions). The upstream route answers one whole JSON
# body, so this bounds the whole call (headers and body), like audio.
#IL2API_DECISIONS_TIMEOUT=120s

# Hard cap on the message count of one chat request, applied after folding and
# as a last resort before trimming the oldest turns. The upstream accepts 100
# and rejects 101 ("This conversation is too long"). 0 disables the cap.
#IL2API_MAX_MESSAGES=96

# Extra upstream attempts when the upstream returns a completion with no text
# at all. Exhausted retries surface as 502 upstream_empty_response instead of
# a silent empty 200. 0 keeps a single attempt.
#IL2API_EMPTY_RETRIES=1

# Fetch a brand-new anonymous session token for every upstream call instead of
# reusing a pooled one. The upstream accumulates history per session token, so
# this trades one round trip per call for isolation. When on, the pool is not
# prewarmed.
#IL2API_SESSION_PER_REQUEST=off

# The server reads this file automatically from its working directory (a
# `KEY=value` file; quotes, `export ` and trailing `# comments` are supported).
# Point this at a different path to load it from elsewhere; an explicitly named
# file that does not exist is a startup error.
# Variables already present in the process environment always win over the file.
#IL2API_ENV_FILE=/etc/inceptionlabs2api.env
